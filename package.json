  "bugs": {
    "url": "https://github.com/ZiraCode/madmovil_server/issues"
  },
  "homepage": "https://github.com/ZiraCode/madmovil_server#readme",
  "dependencies": {
    "hono": "^4.10.6"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@cloudflare/workers-types": "^5.20260814.1",
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.134.0"
  }
}

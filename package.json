{
  "name": "madmovil_server",
  "version": "1.0.0",
  "description": "API de transporte de Madrid (EMT + CRTM + Cercanías) sobre Cloudflare Workers",
  "main": "index.js",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc",
    "typecheck:tests": "tsc -p tsconfig.test.json",
    "lint": "biome lint src tests scripts",
    "format": "biome format --write src tests scripts",
    "format:check": "biome format src tests scripts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZiraCode/madmovil_server.git"
  },
  "keywords": [],
